# === AI 服務 ===
GEMINI_API_KEY=AIzaSy你的Gemini金鑰
PLANTNET_API_KEY=你的PlantNet金鑰

# === GCP Besu 私鏈 ===
BESU_RPC_URL=http://你的節點IP:8545
BESU_CHAIN_ID=1337
DEPLOYER_PRIVATE_KEY=0x你的私鑰（部署合約用）
SIGNER_PRIVATE_KEY=0x你的私鑰（上鏈交易用，可同上）

# === 合約（deploy.js 執行後自動填入）===
CONTRACT_ADDRESS=

# === 伺服器 ===
PORT=3000
UPLOAD_DIR=./uploads

# === 樹種辨識設定 ===
# Pl@ntNet / iNaturalist 最低信心閾值（低於此值視為無效，fallback 到 Gemini）
SPECIES_MIN_CONFIDENCE=0.3
