# 環境變數（含 API 金鑰，絕對不推）
.env

# 依賴套件
node_modules/

# 上傳的影片（可能很大）
uploads/

# 暫存幀
tmp_frames/

# SQLite 資料庫（本地資料，不版控）
data.db
data.db-shm
data.db-wal

# 伺服器 PID
server.pid

# 伺服器日誌
server.log
server-error.log

# 暫存幀與保留幀
tmp_frames/
frames/

# 系統檔案
.DS_Store
Thumbs.db

# 日誌
*.log
npm-debug.log*

# 編譯輸出
artifacts/
